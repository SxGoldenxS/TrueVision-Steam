  "Conditions": {
    "Analytical background": {
      "tab": "TrueVision",
      "description": "Still is the lightweight default. Animated loads the full moving array only when selected. Reduced motion uses a still array.",
      "default": "Still",
      "values": {
        "Still": {},
        "Animated": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "animated.css"
          }
        },
        "Plain": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "quiet.css"
          }
        }
      }
    },
    "Skill profile": {
      "tab": "TrueVision",
      "description": "Raphael / Ciel: gold analytical space. Great Sage: blue ribbons and skill seal. Luminous / Asmodeus: silver/crimson Night Rose. Veldora / Lord of Storms: cyan inscription wheel, prismatic storm and Japanese skill card based on the anime reference.",
      "default": "Raphael / Ciel",
      "values": {
        "Raphael / Ciel": {},
        "Great Sage (blue)": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "great-sage.css"
          }
        },
        "Luminous / Asmodeus": {
