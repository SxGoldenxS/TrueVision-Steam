{
  "name": "TrueVision",
  "author": "Golden",
  "version": "2.1.0",
  "github": {
    "owner": "SxGoldenxS",
    "repo_name": "TrueVision-Steam"
  },
  "description": "TrueVision by Golden. Tensura profiles: Raphael/Ciel, Great Sage, Luminous/Asmodeus and Veldora/Lord of Storms. Standalone tactical interface. For issues, bugs or fixes, message Golden on Discord: daddysxgold.",
  "tags": [
    "TrueVision",
    "Raphael",
    "Ciel",
    "Great Sage",
    "Luminous",
    "Asmodeus",
    "Veldora",
    "Tensura",
    "Dark"
  ],
  "RootColors": "colors.css",
  "Steam-WebKit": "webkit.css",
  "Patches": [
    {
      "MatchRegexString": "^Steam$|DesktopUI|SteamUIPopupWindowBody|^Steam Settings$|^Account$|^Settings$|^OverlayBrowser_Browser$|^SP Overlay:|Supernav$|^notificationtoasts_|^SteamBrowser_Find$|^OverlayTab\\d+_Find$|Menu$|.ModalDialogPopup|.FullModalOverlay",
      "TargetCss": "libraryroot.custom.css",
      "TargetJs": "libraryroot.custom.js"
    },
    {
      "MatchRegexString": "^Steam Big Picture Mode$|^QuickAccess_|^MainMenu_",
      "TargetCss": "bigpicture.custom.css",
      "TargetJs": "activity.js"
    },
    {
      "MatchRegexString": ".friendsui-container",
      "TargetCss": "friends.custom.css",
      "TargetJs": "activity.js"
    },
    {
      "MatchRegexString": "^https://store\\.steampowered\\.com(?:/|$)",
      "TargetCss": "store.css",
      "TargetJs": "activity.js"
    },
    {
      "MatchRegexString": "^https://(?:www\\.)?steamcommunity\\.com(?:/|$)",
      "TargetCss": "community.css",
      "TargetJs": "activity.js"
    }
  ],
  "Conditions": {
    "Analytical background": {
      "tab": "TrueVision",
      "description": "Still is the lightweight default. Animated loads the full moving array only when selected. Reduced motion uses a still array.",
      "default": "Still",
      "values": {
        "Still": {},
        "Animated": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "animated.css"
          }
        },
        "Plain": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "quiet.css"
          }
        }
      }
    },
    "Skill profile": {
      "tab": "TrueVision",
      "description": "Raphael / Ciel: gold analytical space. Great Sage: blue ribbons and skill seal. Luminous / Asmodeus: silver/crimson Night Rose. Veldora / Lord of Storms: cyan inscription wheel, prismatic storm and Japanese skill card based on the anime reference.",
      "default": "Raphael / Ciel",
      "values": {
        "Raphael / Ciel": {},
        "Great Sage (blue)": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "great-sage.css"
          }
        },
        "Luminous / Asmodeus": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "luminous.css"
          }
        },
        "Veldora / Lord of Storms": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "veldora.css"
          }
        }
      }
    },
    "What's New shelf": {
      "tab": "TrueVision",
      "description": "Show or hide the complete Library home news shelf. Applies to every skill profile.",
      "default": "Hidden",
      "values": {
        "Shown": {},
        "Hidden": {
          "TargetCss": {
            "affects": [
              "^Steam$"
            ],
            "src": "news-hidden.css"
          }
        }
      }
    }
  }
}
